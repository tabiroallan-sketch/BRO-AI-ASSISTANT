# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://bro_user:bro_password@localhost:5432/bro

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
# Uses the OpenAI SDK. Point OPENAI_BASE_URL at any OpenAI-compatible endpoint,
# e.g. Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# (then set OPENAI_MODEL to a Gemini model such as gemini-3.5-flash).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# n8n (Milestone 12)
# Base URL of the n8n instance plus an API key (Settings > API in n8n).
# Enables the n8n_* tools: list/get workflows, trigger executions, pass
# variables, monitor executions, receive results, and stop running workflows.
N8N_BASE_URL=
N8N_API_KEY=

# Integrations (Milestone 10)
# Base URL for third-party OAuth callbacks. Each provider app must register
# <INTEGRATION_REDIRECT_BASE>/<provider-id>/callback as a redirect URI.
INTEGRATION_REDIRECT_BASE=http://localhost:3000/api/v1/integrations

# Google Calendar / Gmail / Drive / Docs / Sheets / Tasks / Contacts reuse
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# Register the extra callback URLs in the Google Cloud console:
#   http://localhost:3000/api/v1/integrations/google-calendar/callback
#   http://localhost:3000/api/v1/integrations/google-gmail/callback
#   http://localhost:3000/api/v1/integrations/google-drive/callback
#   http://localhost:3000/api/v1/integrations/google-docs/callback
#   http://localhost:3000/api/v1/integrations/google-sheets/callback
#   http://localhost:3000/api/v1/integrations/google-tasks/callback
#   http://localhost:3000/api/v1/integrations/google-contacts/callback

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack app (OAuth): https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion public integration (OAuth): https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# WhatsApp Business API base (token + phone number ID are entered per-user in Settings)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Integration Marketplace (Milestone 18)
# Dropbox OAuth app: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Zoom OAuth app: https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# ClickUp OAuth app: https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# File that records which marketplace providers are installed/uninstalled.
# Created on first change; leave unset for the default (data/marketplace-state.json).
MARKETPLACE_STATE_FILE=
# Stripe, OpenAI, NVIDIA, Gemini, and Anthropic are API-key (token) integrations:
# their keys are entered per-user from the Marketplace page, no env vars needed.

# Connection Health (Milestone 12)
# Periodic background monitor that probes every connected integration, records
# status/latency/quota, and (when enabled) auto-reconnects expired tokens or
# disables connections whose credentials were revoked on the provider side.
# Per-connection opt-in is controlled from the web Health page.
INTEGRATIONS_HEALTH_MONITOR_ENABLED=true
# How often the monitor sweeps all connected integrations, in milliseconds.
INTEGRATIONS_HEALTH_MONITOR_INTERVAL_MS=600000
INTEGRATIONS_AUTO_RECONNECT_ENABLED=true


# Browser Automation (Milestone 11)
# Playwright-driven browser tools. Set BROWSER_ENABLED=false to disable them even
# when Chromium is installed. Headless mode needs no display (use in Docker).
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
# Launch Chromium with --no-sandbox (required when running as non-root in
# containers; the Docker image sets this automatically).
BROWSER_NO_SANDBOX=false
BROWSER_TIMEOUT=30000
BROWSER_IDLE_TIMEOUT_MS=600000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Performance & caching (Milestone 17)
# In-process TTL cache (bounded, max ~5000 entries). Analytics responses are
# cached per user for ANALYTICS_CACHE_MS; CACHE_TTL_MS is the general default.
# Stale-until-expiry: a cached value is served for its whole TTL, so a write
# (e.g. a new memory) may not show up in cached analytics until it expires.
CACHE_TTL_MS=60000
ANALYTICS_CACHE_MS=60000
# Cache authenticated user rows for this long (ms). 0 disables it. When enabled,
# role/isActive changes take effect only after the TTL unless the admin route
# or login promotes/invalidates them. Leave at 0 unless read-heavy.
AUTH_USER_CACHE_MS=0
# Prisma connection pool. PostgreSQL connection_limit per app instance and the
# pool wait timeout in seconds. Lower DATABASE_POOL_SIZE to bound DB connections
# when running many replicas behind one Postgres.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=5

# Security (Milestone 15)
# Strong key used to encrypt integration access tokens at rest (aes-256-gcm).
# Precedence: ENCRYPTION_KEY then INTEGRATION_ENCRYPTION_KEY then JWT_SECRET.
# In production it MUST be set or the server refuses to start.
ENCRYPTION_KEY=
# Alias for integration tokens; only used when ENCRYPTION_KEY is unset.
INTEGRATION_ENCRYPTION_KEY=
# Comma-separated emails promoted to the ADMIN role on login (RBAC).
ADMIN_EMAILS=
# Trust proxy setting for correct client IPs / secure cookies behind a reverse
# proxy. 'false' to disable, 'loopback' for local proxies, a hop count integer
# (e.g. 1) behind a single proxy, or the proxy's IP/CIDR.
TRUST_PROXY=loopback
# Allowed browser origin for CORS (the web app). Comma-separate multiple
# origins if needed.
CORS_ORIGIN=http://localhost:3001
# Optional key used to sign cookies (defense-in-depth; the OAuth state cookie
# value is already a signed JWT). Set to enable @fastify/cookie signing.
COOKIE_SECRET=
# Reject non-GET requests whose Origin header is not in the CORS allowlist.
# This is CSRF protection for browser-initiated state changes. Keep enabled
# unless the API is consumed exclusively by non-browser clients.
CSRF_PROTECTION_ENABLED=true
# Max audit events kept in memory (oldest are dropped).
AUDIT_LOG_MAX=1000
# Request body size limit in bytes.
BODY_LIMIT_BYTES=1048576
# Maximum request URL length before the server returns 414.
MAX_REQUEST_URL_LENGTH=2048
# Secrets may also be provided via a <NAME>_FILE env var pointing at a file
# containing the value, e.g. JWT_SECRET_FILE=/run/secrets/jwt. When both are
# set, the _FILE variant wins (useful for Docker/Kubernetes secrets).

# Logging
LOG_LEVEL=info

# Plugins (Milestone 14)
# Directory scanned for plugins at startup and on POST /api/v1/plugins/reload.
# Each plugin is a folder (or file) containing bro.plugin.{ts,js,mjs,cjs}.
PLUGINS_DIR=./plugins

# Deployment (Milestone 16)
# Set NODE_ENV=production on the server; the server then requires an explicit
# ENCRYPTION_KEY and enables HSTS. The Docker image already sets NODE_ENV.
# Web build-time URL of the API (baked into the frontend bundle).
# For a local docker compose preview keep the default; for a deployed stack
# point it at the public API, e.g. https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Docker Compose interpolation (see docker-compose.prod.yml):
REGISTRY=ghcr.io/your-org
# Version reported by /health and the web footer (defaults to 0.1.0).
BRO_VERSION=latest