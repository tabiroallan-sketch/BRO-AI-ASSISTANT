generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  googleId      String?  @unique
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  settings      Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations Conversation[]
  memories      Memory[]
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  integrations  Integration[]
  auditLogs     AuditLog[]
  services      Service[]
  opportunities Opportunity[]
  leads         Lead[]
  research      CompanyResearch[]
  drafts        SalesDraft[]
  offers        Offer[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Integration {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  accountKey        String   @default("default")
  accountName       String?
  externalId        String?
  accessToken       String
  refreshToken      String?
  refreshTokenHash  String?
  tokenExpiresAt    DateTime?
  scopes            String?
  metadata          Json?    @default("{}")
  isPrimary         Boolean  @default(false)
  lastRefreshedAt   DateTime?
  refreshCount      Int      @default(0)
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        IntegrationStatus?
  permissionSet PermissionSet?
  syncHistory   SyncHistory[]

  @@unique([userId, provider, accountKey])
  @@index([userId, provider])
  @@map("integrations")
}

model IntegrationStatus {
  id                String    @id @default(uuid())
  integrationId     String    @unique
  status            String
  ok                Boolean   @default(true)
  latencyMs         Int?
  lastMessage       String?
  lastHealthCheckAt DateTime  @default(now())
  lastSuccessAt     DateTime?
  code              String?
  apiStatus         String?
  quota             Json?
  updatedAt         DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_statuses")
}

model PermissionSet {
  id            String   @id @default(uuid())
  integrationId String   @unique
  scopes        Json     @default("[]")
  permissionIds Json     @default("[]")
  grantedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("permission_sets")
}

model SyncHistory {
  id            String   @id @default(uuid())
  integrationId String
  kind          String   @default("health")
  status        String
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  itemCount     Int?
  error         String?
  detail        Json?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
  @@map("sync_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  detail     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  category  String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("memories")
}

model AiConfig {
  id            String    @id
  providerId    String?
  model         String?
  apiKey        String?
  lastStatus    String?
  lastMessage   String?
  lastLatencyMs Int?
  lastTestedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ai_config")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String?
  kind      String?
  priority  String   @default("medium")
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, priority])
  @@index([kind])
  @@map("notifications")
}

model Service {
  id                String    @id @default(uuid())
  userId            String
  name              String
  description       String?
  pricing           String?
  minimumPrice      Decimal?  @db.Decimal(12, 2)
  targetMargin      Int       @default(30)
  requiredSkills    String[]  @default([])
  deliveryEstimate  String?
  upsells           String[]  @default([])
  recurringServices String[]  @default([])
  active            Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("services")
}

model Opportunity {
  id                String            @id @default(uuid())
  userId            String
  title             String
  description       String?
  company           String?
  companyWebsite    String?
  source            String?
  sourceUrl         String?
  location          String?
  remote            Boolean           @default(false)
  compensation      String?
  currency          String            @default("USD")
  employmentType    String?
  requiredSkills    String[]          @default([])
  technologies      String[]          @default([])
  estimatedBudget   Decimal?          @db.Decimal(12, 2)
  industry          String?
  companySize       String?
  clientName        String?
  clientRole        String?
  postedAt          DateTime?
  deadline          DateTime?
  recurringPotential Boolean          @default(false)
  sourceReliability String?
  rawContent        String?
  urgency           String?
  type              OpportunityType   @default(POTENTIAL_CLIENT)
  score             Int               @default(0)
  status            OpportunityStatus @default(NEW)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads Lead[]
  drafts SalesDraft[]
  offers Offer[]

  @@index([userId])
  @@unique([userId, source, sourceUrl])
  @@map("opportunities")
}

model Offer {
  id               String            @id @default(uuid())
  userId           String
  opportunityId    String?
  leadId           String?
  name             String
  description      String?
  components       Json?             @default("[]")
  suggestedPrice   Decimal?          @db.Decimal(12, 2)
  minimumPrice     Decimal?          @db.Decimal(12, 2)
  targetMargin     Int               @default(30)
  currency         String            @default("USD")
  deliveryEstimate String?
  validDays        Int               @default(30)
  status           OfferStatus       @default(DRAFT)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([opportunityId])
  @@index([leadId])
  @@map("offers")
}

model Lead {
  id             String     @id @default(uuid())
  userId         String
  name           String
  company        String?
  position       String?
  email          String?
  phone          String?
  linkedinUrl    String?
  website        String?
  source         String?
  opportunityId  String?
  score          Int        @default(0)
  status         LeadStatus @default(NEW)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  probability    Int        @default(0)
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  drafts      SalesDraft[]
  offers      Offer[]

  @@index([userId])
  @@index([opportunityId])
  @@map("leads")
}

model CompanyResearch {
  id          String   @id @default(uuid())
  userId      String
  companyName String?
  website     String?
  industry    String?
  findings    Json     @default("{}")
  source      String?
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("company_research")
}

model SalesDraft {
  id             String         @id @default(uuid())
  userId         String
  leadId         String?
  opportunityId  String?
  kind           SalesDraftKind @default(COLD_EMAIL)
  channel        String         @default("email")
  recipientName  String?
  recipientEmail String?
  subject        String?
  content        String
  status         DraftStatus    @default(DRAFT)
  approvedAt     DateTime?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leadId])
  @@map("sales_drafts")
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum Role {
  USER
  ADMIN
}

enum OpportunityType {
  JOB
  POTENTIAL_CLIENT
  OUTSOURCING
  PARTNERSHIP
  RECURRING
}

enum OpportunityStatus {
  NEW
  EVALUATING
  PROPOSED
  WON
  LOST
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  RESPONDED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum SalesDraftKind {
  COLD_EMAIL
  LINKEDIN
  JOB_APPLICATION
  FOLLOW_UP
  PROPOSAL
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
}