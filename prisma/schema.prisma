generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  googleId      String?  @unique
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations Conversation[]
  memories      Memory[]
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  integrations  Integration[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Integration {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  accountKey        String   @default("default")
  accountName       String?
  externalId        String?
  accessToken       String
  refreshToken      String?
  refreshTokenHash  String?
  tokenExpiresAt    DateTime?
  scopes            String?
  metadata          Json?    @default("{}")
  isPrimary         Boolean  @default(false)
  lastRefreshedAt   DateTime?
  refreshCount      Int      @default(0)
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        IntegrationStatus?
  permissionSet PermissionSet?
  syncHistory   SyncHistory[]

  @@unique([userId, provider, accountKey])
  @@index([userId, provider])
  @@map("integrations")
}

model IntegrationStatus {
  id                String    @id @default(uuid())
  integrationId     String    @unique
  status            String
  ok                Boolean   @default(true)
  latencyMs         Int?
  lastMessage       String?
  lastHealthCheckAt DateTime  @default(now())
  lastSuccessAt     DateTime?
  code              String?
  apiStatus         String?
  quota             Json?
  updatedAt         DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_statuses")
}

model PermissionSet {
  id            String   @id @default(uuid())
  integrationId String   @unique
  scopes        Json     @default("[]")
  permissionIds Json     @default("[]")
  grantedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("permission_sets")
}

model SyncHistory {
  id            String   @id @default(uuid())
  integrationId String
  kind          String   @default("health")
  status        String
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  itemCount     Int?
  error         String?
  detail        Json?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
  @@map("sync_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  detail     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  category  String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("memories")
}

model AiConfig {
  id            String    @id
  providerId    String?
  model         String?
  apiKey        String?
  lastStatus    String?
  lastMessage   String?
  lastLatencyMs Int?
  lastTestedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ai_config")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

enum Role {
  USER
  ADMIN
}