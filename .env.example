# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://bro_user:bro_password@localhost:5432/bro

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info